---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import DateFormatter from '../FormattedDate/DateFormatter.astro';
import placeholderCover from '../../assets/images/blog-placeholder-astro.jpg';

type Post = CollectionEntry<'blog'>;

interface Props {
  // Any object shaped like (a subset of) a blog post, so a full collection entry can be passed as-is:
  card: Pick<Post, 'id'> & {
    data: Pick<Post['data'], 'title' | 'cover' | 'coverAlt' | 'pubDate' | 'description'>;
  };
  orientation?: 'landscape' | 'portrait' | 'responsive';
}

const { card, orientation = 'portrait' } = Astro.props;
const { title, cover = placeholderCover, coverAlt = '', pubDate, description } = card.data;
const href = `/${card.id}/`;
---

<!-- `data-orientation` drives the `card-landscape:`/`card-portrait:` variants (see global.tw.css) -->
<li
  data-orientation={orientation}
  class:list={[
    'relative mb-0 flex overflow-hidden rounded-2xl bg-fg/8 shadow-card hover:shadow-card-hover',
    'transition duration-300 hover:bg-fg/12 motion-safe:hover:-translate-y-2',
    // The title link is outline-less, so show its keyboard focus ring around the whole card instead:
    'has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent',
    'card-landscape:flex-row card-portrait:w-120 card-portrait:flex-col card-portrait:aspect-(--card-aspect)',
  ]}
  style={{
    // Landscape: fixed height of the text block: 1-line title + date + 2-line description + 2 gaps.
    '--text-height': 'calc(1.5em * 1.25 + 0.875em * 1.7 + 2 * 0.95em * 1.7 + 2 * 0.25em)',
    // Plus the text block's `p-6` top and bottom padding. The cover uses this full card height,
    // so it lines up with the card's outer edges:
    '--card-height': 'calc(var(--text-height) + var(--spacing) * 12)',
    // Portrait: the cover spans the card width, so this makes the card 2.4x the cover's height:
    '--card-aspect': `${cover.width} / ${cover.height * 2.4}`,
  }}
>
  <div class='flex min-w-0 grow flex-col gap-[0.25em] p-6 card-landscape:h-(--card-height) card-landscape:justify-center'>
    <!-- Stretched link: the ::after overlay makes the entire card clickable -->
    <a
      href={href}
      class:list={[
        'font-bold leading-tight text-titles no-underline outline-none after:absolute after:inset-0',
        'card-landscape:text-[1.5em] card-landscape:line-clamp-1 card-portrait:text-[1.2em]',
      ]}
    >
      {title}
    </a>
    {pubDate && (
      <DateFormatter
        date={pubDate}
        class='leading-[1.7] text-gray-500 card-landscape:text-[0.875em] card-portrait:text-[0.75em]'
      />
    )}
    {description && (
      <p
        class:list={[
          'my-0 leading-[1.7] font-medium text-[light-dark(var(--color-gray-600),var(--color-gray-400))]',
          'card-landscape:text-[0.95em] card-landscape:line-clamp-2 card-portrait:text-[0.85em] card-portrait:line-clamp-4',
        ]}
      >
        {description}
      </p>
    )}
    <!-- Raised above the stretched link's overlay, so these links stay clickable -->
    {Astro.slots.has('actions') && (
      <div class='relative z-10 mt-auto self-end italic [&_a]:no-underline'>
        <slot name='actions' />
      </div>
    )}
  </div>

  <!-- Placed last in the DOM so the title is read first, but shown first via `order-first` -->
  <Image
    src={cover}
    alt={coverAlt}
    width={600}
    class:list={[
      'order-first shrink-0 rounded-none',
      // Landscape: fills the card height, compressed horizontally to a 16:10 box (`object-fit: fill`):
      'card-landscape:h-(--card-height) card-landscape:w-auto card-landscape:aspect-16/10',
      'card-portrait:h-auto card-portrait:w-full',
    ]}
  />
</li>
