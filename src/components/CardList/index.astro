---
import type { ComponentProps } from 'astro/types';
import Card from './Card.astro';

type CardProps = ComponentProps<typeof Card>;

interface Props {
  cards: CardProps['card'][];
  orientation?: CardProps['orientation'];
}

const { cards, orientation = 'portrait' } = Astro.props;
---

<ul
  data-orientation={orientation}
  class='list-none pl-0 flex gap-8 card-landscape:flex-col card-portrait:flex-wrap'
>
  {cards.map((card) => <Card card={card} orientation={orientation} />)}
</ul>
