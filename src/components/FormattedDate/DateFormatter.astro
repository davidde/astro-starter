---
interface Props {
  date: Date;
  format?: 'short' | 'long';
  class?: string;
}

const { date, format = 'long', class: className } = Astro.props;

// ISO standard format for short (YYYY-MM-DD):
// (Use getters to prevent off-by-1 date bugs, e.g. when using `date.toISOString().split('T')[0])`)
const year = date.getFullYear();
const month = String(date.getMonth() + 1).padStart(2, '0');
const day = String(date.getDate()).padStart(2, '0');
const shortDate = `${year}-${month}-${day}`;

const formattedDate = format === 'short' ?
  shortDate
  : // Localized long format (e.g. (January 1, 2026)):
  date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
---

<time class:list={[className]} datetime={shortDate}>
  { formattedDate }
</time>
