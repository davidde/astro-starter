---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate/index.astro';


interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  author?: string;
  draft?: boolean;
}

const { title, description, pubDate, updatedDate, tags, cover, coverAlt, author, draft } = Astro.props;
---


<BaseLayout>
  <main class="markdown mx-auto w-7xl max-w-[calc(100%-1.5em)]">
    <article class="w-full">
      <div class="leading-none mb-[2em]">
        <h1 class="mb-0">{title}</h1>
        <FormattedDate className="text-gray-500 text-[0.875em]" pubDate={pubDate} updatedDate={updatedDate} />
        <hr />
      </div>

      <div class="w-full mb-20">
        {
          cover &&
            <Image
              class="block rounded-4xl m-[0_auto] shadow-(--box-shadow)"
              width={1020}
              height={510}
              src={cover}
              alt={coverAlt ?? ''}
            />
        }
      </div>

      <slot />
    </article>
  </main>
</BaseLayout>